{
  "$schema": "https://raw.githubusercontent.com/vestia-dev/recon/main/recon.schema.json",
  "configVersion": 1,
  "rules": [
    {
      "id": "no-is-record",
      "message": "isRecord is pure slop. don't be so dumb. do better. be better.",
      "target": "added-lines",
      "extension": [
        ".ts"
      ],
      "contentRegex": [
        "\\bisRecord\\b"
      ]
    }
  ]
}
